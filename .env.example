# ---- Data feed (no key needed)
# off = disable the election-results feed
VITE_DATA_SOURCE=
# 2024 = Open America's replay of certified 2024 results, for development only (shown with a demo banner)
VITE_OA_YEAR=

# ---- Ad auction (put real values in .env.local for local tests, or in Cloudflare Pages → Settings → Variables and Secrets)
# Without MP_ACCESS_TOKEN, `npm run dev` uses a fake "pay" page (no real money). Production NEVER uses it.
# MP_ACCESS_TOKEN=APP_USR-...        Mercado Pago → Suas integrações → Credenciais de produção (TEST-... for sandbox)
# MP_WEBHOOK_SECRET=...              Mercado Pago → Suas integrações → Webhooks → chave secreta
# ADMIN_TOKEN=...                    long random string, used only for moderation calls to /api/ads/admin
# SITE_URL=https://your-site.pages.dev   optional; defaults to the address the request came from

# ---- Countdown to the start of the count (home page, format HH:MM:SS)
# Instant when the vote count is expected to start, ISO 8601 WITH offset. Set it as a variable in Cloudflare Pages
# (Settings → Variables) to change it WITHOUT rebuilding; invalid values are ignored.
# Default: 2026-11-03T23:00:00Z = 6:00 p.m. US Eastern, when the first polls close (source: CBS News, Quartz).
# Results sources are only queried after this instant.
# COUNTDOWN_TARGET=2026-11-03T23:00:00Z

# ---- Company logos in ads (all optional; without them the ad shows a monogram, and site-URL detection still works)
# LOGODEV_SECRET_KEY=sk_...          Logo.dev dashboard → API keys. SERVER-ONLY secret (Search API). Never commit it.
# LOGODEV_PUBLISHABLE_KEY=pk_...     Logo.dev publishable key; visible in the browser by design, so restrict it to your domain in the dashboard.
#                                    Setting it also shows the required "Logos provided by Logo.dev" footer link.
# BRANDFETCH_CLIENT_ID=...           Brandfetch Developer Portal → Logo API client ID (public). Enables Brandfetch search + CDN fallback.
