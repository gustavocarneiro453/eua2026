# ---- Data feed (no key needed)
# off = disable the election-results feed
VITE_DATA_SOURCE=
# 2024 = Open America's replay of certified 2024 results, for development only (shown with a demo banner)
VITE_OA_YEAR=

# ---- Countdown to the start of the count (home page, format HH:MM:SS)
# Instant when the vote count is expected to start, ISO 8601 WITH offset. Set it as a variable in Cloudflare Pages
# (Settings → Variables) to change it WITHOUT rebuilding; invalid values are ignored.
# Default: 2026-11-03T23:00:00Z = 6:00 p.m. US Eastern, when the first polls close (source: CBS News, Quartz).
# Results sources are only queried after this instant.
# COUNTDOWN_TARGET=2026-11-03T23:00:00Z
